{
  "name": "sistema-ferias",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 5000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 5000 -H 0.0.0.0",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.node.json",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:unit": "tsx --test \"test/*.test.ts\"",
    "test:property": "tsx --test \"test/property/**/*.test.ts\"",
    "test:coverage": "c8 --check-coverage tsx --test \"test/utils.test.ts\" \"test/uuid-v7.test.ts\" \"test/input-validation.test.ts\" \"test/storage-errors.test.ts\" \"test/handle-demo-error.test.ts\" \"test/rate-limit.test.ts\" \"test/property/**/*.test.ts\"",
    "test:mutation": "stryker run",
    "complexity": "eslint lib app components types --max-warnings 0",
    "audit": "npm audit --audit-level=high",
    "audit:ci": "node ./scripts/audit-ci.cjs",
    "gitleaks": "gitleaks detect --source . --verbose --config .github/gitleaks.toml",
    "knip": "knip --include dependencies,unlisted,binaries --no-progress --no-config-hints",
    "prepare": "node ./scripts/prepare-husky.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "bcryptjs": "2.4.3",
    "date-fns": "4.1.0",
    "jsonwebtoken": "9.0.2",
    "lucide-react": "0.453.0",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.5.1",
    "react-virtuoso": "4.12.3",
    "recharts": "2.15.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.22.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/bcryptjs": "2.4.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.8.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "audit-ci": "7.1.0",
    "autoprefixer": "10.4.20",
    "c8": "10.1.3",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.1",
    "eslint-import-resolver-typescript": "3.9.1",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-unicorn": "56.0.1",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "knip": "5.66.0",
    "lint-staged": "16.0.0",
    "playwright": "1.55.1",
    "postcss": "8.5.31",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "typescript-eslint": "8.57.0"
  },
  "c8": {
    "all": true,
    "include": [
      "lib/utils.ts",
      "lib/uuid-v7.ts",
      "lib/input-validation.ts",
      "lib/storage-errors.ts",
      "lib/handle-demo-error.ts",
      "lib/rate-limit.ts"
    ],
    "exclude": [
      "test/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "node_modules/**",
      ".next/**"
    ],
    "reporter": [
      "lcov",
      "text",
      "html",
      "json-summary"
    ],
    "check-coverage": true,
    "branches": 90,
    "functions": 90,
    "lines": 90,
    "statements": 90,
    "watermarks": {
      "branches": [
        80,
        90
      ],
      "functions": [
        80,
        90
      ],
      "lines": [
        80,
        90
      ],
      "statements": [
        80,
        90
      ]
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings 0 --fix"
    ]
  }
}
