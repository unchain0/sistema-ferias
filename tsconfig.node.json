{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "jest", "@types/node"],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "eslint.config.js",
    ".eslintrc.json",
    "next.config.js",
    "tailwind.config.ts",
    "postcss.config.mjs",
    "scripts/**/*",
    "test/**/*",
    ".github/workflows/**/*",
    "lib/**/*.test.ts"
  ],
  "exclude": ["node_modules", ".next", "out", "dist"]
}