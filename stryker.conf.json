{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker/master/packages/api/schema/stryker-core.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node scripts/run-mutation-tests.cjs"
  },
  "checkers": [],
  "mutate": [
    "lib/utils.ts",
    "lib/uuid-v7.ts",
    "lib/input-validation.ts",
    "lib/storage-errors.ts",
    "lib/handle-demo-error.ts"
  ],
  "ignorePatterns": [
    "node_modules",
    ".next",
    "coverage",
    "app",
    "components",
    ".stryker-tmp",
    "docs",
    "attached_assets"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "thresholds": {
    "high": 70,
    "low": 50,
    "break": 40
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "timeoutFactor": 2,
  "coverageAnalysis": "off",
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true,
  "buildCommand": ""
}
