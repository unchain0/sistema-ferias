# NextAuth Configuration
# URL da aplicação (em desenvolvimento: http://localhost:5000, em produção: https://seu-dominio.com)
NEXTAUTH_URL=http://localhost:5000

# Chave secreta para criptografia de tokens e cookies
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Supabase Configuration
# URL do projeto. Local CLI: http://127.0.0.1:54321 | Produção: https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anon key (pública). Fornecida pelo 'supabase status' localmente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secrets (Server-side only)
# JWT Secret para assinar tokens que respeitam RLS. Encontre em: Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# Service Role Key (secret). Acesso total, ignora RLS. Use para sementes (seeds) e scripts admin.
# Local CLI: 'supabase status' | Produção: Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
