# NextAuth Configuration
# URL da aplicação (em desenvolvimento: http://localhost:5000, em produção: https://seu-dominio.com)
NEXTAUTH_URL=http://localhost:5000

# Chave secreta para criptografia de tokens e cookies
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Supabase Configuration
# Local CLI: Use 'Project URL' do comando `supabase status`
# Produção: Encontre em Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anon key (pública). 
# Local CLI: Use o valor de 'Publishable' (sb_publishable_...) do comando `supabase status`
# Produção: Encontre em Settings > API > anon (public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secrets (Server-side only)
# JWT Secret para assinar tokens que respeitam RLS. 
# Produção: Encontre em Settings > API > JWT Settings > JWT Secret
# Local CLI: O padrão do Supabase local geralmente é 'super-secret-jwt-token-with-at-least-32-characters-long'
SUPABASE_JWT_SECRET=your-jwt-secret

# Service Role Key (secret). Acesso total, ignora RLS.
# Local CLI: Use o valor de 'Secret' (sb_secret_...) do comando `supabase status`
# Produção: Encontre em Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
