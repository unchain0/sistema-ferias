# NextAuth Configuration
# URL da aplicação (em desenvolvimento: http://localhost:5000, em produção: https://seu-dominio.com)
NEXTAUTH_URL=http://localhost:5000

# Chave secreta para criptografia de tokens e cookies
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here

# Supabase Configuration
# Encontre em: Project Settings > API
# Para desenvolvimento local com CLI use: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# Para desenvolvimento local use a anon key fornecida pelo 'supabase status'
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Secrets (Server-side only)
# Encontre em: Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=seu-jwt-secret

# Encontre em: Project Settings > API > service_role key (secret)
# Para desenvolvimento local use a service_role key fornecida pelo 'supabase status'
# CUIDADO: Esta chave tem acesso total ao banco de dados. Nunca exponha no client-side.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key
